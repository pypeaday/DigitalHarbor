{
  "$schema": "https://emdashcms.com/seed.schema.json",
  "version": "1",
  "meta": {
    "name": "Digital Harbor",
    "description": "Digital Harbor \u2014 a web studio for local business",
    "author": "Digital Harbor"
  },
  "settings": {
    "title": "Digital Harbor",
    "tagline": "Websites, built and kept running."
  },
  "collections": [
    {
      "slug": "pages",
      "label": "Pages",
      "labelSingular": "Page",
      "urlPattern": "/{slug}",
      "supports": [
        "drafts",
        "revisions",
        "preview",
        "search",
        "seo"
      ],
      "fields": [
        {
          "slug": "title",
          "label": "Title",
          "type": "string",
          "required": true,
          "searchable": true
        },
        {
          "slug": "description",
          "label": "Description",
          "type": "text"
        },
        {
          "slug": "content",
          "label": "Body",
          "type": "portableText",
          "searchable": true
        }
      ]
    },
    {
      "slug": "services",
      "label": "Services",
      "labelSingular": "Service",
      "supports": [
        "drafts",
        "revisions",
        "search"
      ],
      "fields": [
        {
          "slug": "title",
          "label": "Title",
          "type": "string",
          "required": true,
          "searchable": true
        },
        {
          "slug": "kicker",
          "label": "Kicker",
          "type": "string"
        },
        {
          "slug": "description",
          "label": "Description",
          "type": "text",
          "searchable": true
        },
        {
          "slug": "features",
          "label": "Features",
          "type": "repeater",
          "validation": {
            "subFields": [
              {
                "slug": "text",
                "label": "Text",
                "type": "string",
                "required": true
              }
            ]
          }
        },
        {
          "slug": "cta_label",
          "label": "CTA label",
          "type": "string"
        },
        {
          "slug": "cta_url",
          "label": "CTA URL",
          "type": "url"
        },
        {
          "slug": "show_on_home",
          "label": "Show on home",
          "type": "boolean"
        },
        {
          "slug": "sort_order",
          "label": "Sort order",
          "type": "number"
        }
      ]
    },
    {
      "slug": "linkpages",
      "label": "Link Pages",
      "labelSingular": "Link Page",
      "urlPattern": "/harbors/{slug}",
      "supports": [
        "drafts",
        "revisions",
        "preview"
      ],
      "fields": [
        {
          "slug": "title",
          "label": "Title",
          "type": "string",
          "required": true
        },
        {
          "slug": "tagline",
          "label": "Tagline",
          "type": "string"
        },
        {
          "slug": "description",
          "label": "Description",
          "type": "text"
        },
        {
          "slug": "accent",
          "label": "Accent color (hex)",
          "type": "string"
        },
        {
          "slug": "avatar",
          "label": "Avatar / logo",
          "type": "image"
        },
        {
          "slug": "links",
          "label": "Links",
          "type": "repeater",
          "validation": {
            "subFields": [
              {
                "slug": "label",
                "label": "Label",
                "type": "string",
                "required": true
              },
              {
                "slug": "url",
                "label": "URL",
                "type": "url",
                "required": true
              }
            ]
          }
        },
        {
          "slug": "footer_note",
          "label": "Footer note",
          "type": "string"
        }
      ]
    },
    {
      "slug": "leads",
      "label": "Leads",
      "labelSingular": "Lead",
      "supports": [
        "search"
      ],
      "fields": [
        {
          "slug": "title",
          "label": "Title",
          "type": "string",
          "required": true,
          "searchable": true
        },
        {
          "slug": "name",
          "label": "Name",
          "type": "string",
          "searchable": true
        },
        {
          "slug": "email",
          "label": "Email",
          "type": "string",
          "searchable": true
        },
        {
          "slug": "business",
          "label": "Business",
          "type": "string",
          "searchable": true
        },
        {
          "slug": "project_type",
          "label": "Project type",
          "type": "select",
          "validation": {
            "options": [
              "website",
              "maintenance",
              "linkpage",
              "qr",
              "other"
            ]
          }
        },
        {
          "slug": "message",
          "label": "Message",
          "type": "text",
          "searchable": true
        },
        {
          "slug": "lead_status",
          "label": "Status",
          "type": "select",
          "required": true,
          "defaultValue": "new",
          "validation": {
            "options": [
              "new",
              "contacted",
              "quoted",
              "won",
              "lost"
            ]
          }
        },
        {
          "slug": "submitted_at",
          "label": "Submitted at",
          "type": "string"
        },
        {
          "slug": "source",
          "label": "Source",
          "type": "string"
        }
      ]
    },
    {
      "slug": "site_content",
      "label": "Site Content",
      "labelSingular": "Site Content",
      "singleton": true,
      "supports": [
        "revisions"
      ],
      "fields": [
        {
          "slug": "title",
          "label": "Title",
          "type": "string",
          "required": true
        },
        {
          "slug": "hero_headline",
          "label": "Hero headline",
          "type": "text"
        },
        {
          "slug": "hero_subtext",
          "label": "Hero subtext",
          "type": "text"
        },
        {
          "slug": "email",
          "label": "Contact email",
          "type": "string"
        },
        {
          "slug": "location",
          "label": "Location line",
          "type": "string"
        },
        {
          "slug": "github",
          "label": "GitHub URL",
          "type": "url"
        },
        {
          "slug": "announcement",
          "label": "Announcement",
          "type": "text"
        }
      ]
    }
  ],
  "menus": [
    {
      "name": "primary",
      "label": "Primary Navigation",
      "items": [
        {
          "type": "custom",
          "label": "Work",
          "url": "/sites"
        },
        {
          "type": "custom",
          "label": "Services",
          "url": "/services"
        },
        {
          "type": "custom",
          "label": "QR",
