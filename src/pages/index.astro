---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteCard from '../components/SiteCard.astro';
import ServiceCard from '../components/ServiceCard.astro';
import QRGallery from '../components/QRGallery.astro';
import FleetGraph from '../components/FleetGraph.astro';
import { MonitorSmartphone, Wrench, Link2, ArrowRight, Bell } from 'lucide-astro';
import { getEmDashCollection } from 'emdash';
import { env } from 'cloudflare:workers';
import { getSiteContent } from '../utils/site';
import { SITES } from '../data/sites';
import { getSiteSessions, getOpsMap, opsAllowed } from '../lib/devin';
const [sessions, site, servicesResult] = await Promise.all([
  getSiteSessions(env, Astro.locals.cfContext, SITES),
  getSiteContent(),
  getEmDashCollection('services', {
    orderBy: { sort_order: 'asc' },
    limit: 50,
  }),
]);
if (Astro.cache?.enabled && servicesResult.cacheHint) {
  Astro.cache.set(servicesResult.cacheHint);
}
const showOps = opsAllowed(env, Astro.url);
const opsMap = showOps ? getOpsMap(env) : {};

const featured = SITES.filter(
  (s) => s.status === 'live' || s.status === 'building',
).slice(0, 6);
const counts = {
  live: SITES.filter((s) => s.status === 'live').length,
  building: SITES.filter((s) => s.status === 'building').length,
};

const icons = [MonitorSmartphone, Wrench, Link2, Bell];
// Notifiq renders as its own coming-soon banner, not a service card.
const services = servicesResult.entries
  .filter((s) => s.data.show_on_home === true)
  .map((s, i) => ({
    slug: s.slug,
    icon: icons[i % icons.length],
    kicker: s.data.kicker ?? 'Service',
    title: s.data.title,
    description: s.data.description ?? '',
    features: (s.data.features ?? []).map(
      (f: { text?: string }) => f.text ?? '',
    ),
    ctaText: s.data.cta_label ?? 'Learn more',
    ctaHref: s.data.cta_url ?? '/contact',
  }));
const mainServices = services.filter((s) => s.slug !== 'notifiq');
const notifiq = services.find((s) => s.slug === 'notifiq');

const heroHeadline =
  site.hero_headline ?? 'Websites, built and kept running.';

const qrCategories = [
  {
    title: 'Professional',
    description: 'Standard QR codes with brand colors and logo integration.',
    mainImage: '/qr/professional/26-04-2024_15-21-12-1-qr.png',
    thumbnails: [
      '/qr/professional/26-04-2024_15-06-58-0-qr.png',
      '/qr/professional/26-04-2024_15-06-58-2-qr.png',
      '/qr/professional/26-04-2024_15-06-58-3-qr.png',
      '/qr/professional/26-04-2024_15-06-58-4-qr.png',
    ],
    galleryHref: '/qr/professional',
  },
  {
    title: 'Artisanal',
    description: 'AI-generated artistic QR codes with custom imagery and themes.',
    mainImage: '/qr/artisanal/nyc-cyberpunk.png',
    thumbnails: [
      '/qr/artisanal/eiffel-tower.png',
      '/qr/artisanal/beach-sunrise.png',
      '/qr/artisanal/galaxy.png',
      '/qr/artisanal/opera.png',
    ],
    galleryHref: '/qr/artisanal',
  },
];
---

<BaseLayout title="Digital Harbor — Websites built &amp; kept running">
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="contour-field" aria-hidden="true"></div>
    <div class="lantern-glow left-1/2 top-24 h-96 w-[52rem] -translate-x-1/2" aria-hidden="true"></div>
    <FleetGraph />

    <div class="relative mx-auto max-w-6xl px-4 pb-24 pt-28 md:pt-36">
      <p class="kicker mb-6">{site.location}</p>

      <h1 class="display max-w-3xl text-5xl leading-[1.05] md:text-7xl">
        {heroHeadline}
      </h1>

      <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-mute">
        {site.hero_subtext}
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-3">
        <a href="#work" class="btn-brass">See the work</a>
        <a href="/sites" class="btn-ghost">
          Full board <ArrowRight class="h-4 w-4" />
        </a>
      </div>

      <div class="mt-14 flex flex-wrap gap-x-8 gap-y-2 font-mono text-[11px] uppercase tracking-[0.22em] text-ink-faint">
        <span class="inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-signal"></span><span class="text-signal">{counts.live}</span> live</span>
        <span class="inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-brass"></span><span class="text-brass">{counts.building}</span> building</span>
        <span class="inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-ink-faint"></span>{SITES.length} in the registry</span>
      </div>
    </div>
  </section>

  <!-- Work -->
  <section id="work" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-16">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="kicker mb-3">The fleet</p>
        <h2 class="display text-3xl md:text-4xl">Live at the harbor</h2>
        <p class="mt-3 max-w-lg text-ink-mute">
          Real client work and studio projects — with live status pulled
          straight from the shop floor.
        </p>
      </div>
      <a href="/sites" class="flex items-center gap-1.5 text-sm text-water transition-colors hover:text-brass">
        All {SITES.length} sites <ArrowRight class="h-4 w-4" />
      </a>
    </div>

    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {featured.map((site) => (
        <SiteCard
          site={site}
          sessions={sessions[site.slug]}
          ops={opsMap[site.slug]}
          showOps={showOps}
        />
      ))}
    </div>
  </section>

  <hr class="hairline mx-auto max-w-6xl" />

  <!-- Services -->
  <section id="services" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-24">
    <p class="kicker mb-3">Services</p>
    <h2 class="display mb-4 text-3xl md:text-4xl">What we do</h2>
    <p class="mb-12 max-w-lg text-ink-mute">
      Three ways to work together — a new site, a takeover of your
      existing one, or QR codes that get noticed.
    </p>

    <div class="grid gap-5 md:grid-cols-3">
      {mainServices.map((s) => <ServiceCard {...s} />)}
    </div>

    {notifiq && (
      <div class="card-dock mt-5 flex flex-col items-start gap-4 md:flex-row md:items-center md:gap-8">
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-brass/25 bg-brass/10">
          <Bell class="h-5 w-5 text-brass" />
        </div>
        <div class="min-w-0 flex-1">
          <p class="kicker mb-1">{notifiq.kicker}</p>
          <h3 class="display text-xl">{notifiq.title}</h3>
          <p class="mt-1 text-sm leading-relaxed text-ink-mute">{notifiq.description}</p>
        </div>
        <a href={notifiq.ctaHref} class="btn-ghost shrink-0 text-sm">{notifiq.ctaText}</a>
      </div>
    )}
  </section>

  <hr class="hairline mx-auto max-w-6xl" />

  <!-- QR Gallery -->
  <section id="qr-gallery" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-24">
    <p class="kicker mb-3">Print &rarr; pixel</p>
    <h2 class="display mb-4 text-3xl md:text-4xl">QR codes worth scanning</h2>
    <p class="mb-12 max-w-lg text-ink-mute">
      From clean branded codes to AI-generated art that still scans every time.
    </p>
    <QRGallery categories={qrCategories} />
  </section>

  <hr class="hairline mx-auto max-w-6xl" />

  <!-- Contact -->
  <section class="mx-auto max-w-6xl px-4 py-28 text-center">
    <p class="kicker mb-4">Open for work</p>
    <h2 class="display mx-auto max-w-2xl text-4xl md:text-5xl">
      Ready to come into <em class="text-brass">harbor</em>?
    </h2>
    <p class="mx-auto mt-5 max-w-md text-ink-mute">
      One email starts it. Tell us about the business — we'll tell you
      honestly what you need (and what you don't).
    </p>
    <a href="/contact" class="btn-brass mt-10 text-lg">
      Start a project
    </a>
  </section>
</BaseLayout>

<script>
  // Client-side reachability probe for cards marked data-check.
  document.querySelectorAll<HTMLElement>('[data-check]').forEach((el) => {
    const url = el.dataset.check;
    const dot = el.querySelector<HTMLElement>('.check-dot');
    if (!url || !dot) return;
    fetch(url, { mode: 'no-cors', cache: 'no-store' })
      .then(() => {
        dot.classList.remove('bg-ink-faint');
        dot.classList.add('bg-signal');
        dot.title = 'reachable';
      })
      .catch(() => {
        dot.classList.add('bg-buoy');
        dot.title = 'unreachable';
      });
  });
</script>
