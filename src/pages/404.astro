---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Lost at sea — Digital Harbor">
  <section class="mx-auto flex max-w-2xl flex-col items-center px-4 py-32 text-center">
    <p class="kicker mb-4">404 — off the chart</p>
    <h1 class="display text-5xl md:text-6xl">Lost at <em class="text-brass">sea</em>.</h1>
    <p class="mt-5 max-w-sm text-ink-mute">
      That page isn't in the harbor. Head back to port and try again.
    </p>
    <a href="/" class="btn-brass mt-10">Back to port</a>
  </section>
</BaseLayout>
