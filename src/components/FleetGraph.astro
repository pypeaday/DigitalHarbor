---
// Ambient fleet map — the live site registry as harbor traffic.
// Pure SVG + SMIL/CSS, no JS. Decorative only (aria-hidden, pointer-events none).
import { SITES } from '../data/sites';

const STATUS_COLOR: Record<string, string> = {
  live: '#4FD1A5',
  building: '#E0A458',
  paused: '#5E748C',
  planned: '#5E748C',
};

// The studio site IS the hub — everyone else orbits.
const nodes = SITES.filter((s) => s.slug !== 'mydigitalharbor');

const cx = 280;
const cy = 218;
const rx = 206;
const ry = 144;

const placed = nodes.map((s, i) => {
  const a = (-90 + (i * 360) / nodes.length) * (Math.PI / 180);
  const x = cx + rx * (i % 2 ? 0.9 : 1.04) * Math.cos(a);
  const y = cy + ry * (i % 3 === 0 ? 0.88 : 1.02) * Math.sin(a);

  // Curved edge into the hub — alternating swoop direction like mooring lines.
  const mx = (x + cx) / 2;
  const my = (y + cy) / 2;
  const dx = cx - x;
  const dy = cy - y;
  const len = Math.hypot(dx, dy);
  const bend = len * 0.22 * (i % 2 ? 1 : -1);
  const qx = mx + (-dy / len) * bend;
  const qy = my + (dx / len) * bend;
  const edge = `M ${x.toFixed(1)} ${y.toFixed(1)} Q ${qx.toFixed(1)} ${qy.toFixed(1)} ${cx} ${cy}`;
  const edgeR = `M ${cx} ${cy} Q ${qx.toFixed(1)} ${qy.toFixed(1)} ${x.toFixed(1)} ${y.toFixed(1)}`;

  return {
    s,
    x,
    y,
    edge,
    edgeR,
    id: `fe-${i}`,
    status: STATUS_COLOR[s.status] ?? '#5E748C',
    inDur: (6 + (i % 4) * 1.7).toFixed(1),
    outDur: (7 + (i % 3) * 2.1).toFixed(1),
    begin: `-${(i * 0.9).toFixed(1)}s`,
    outbound: i % 2 === 0,
  };
});
---

<div
  class="fleet-graph pointer-events-none absolute right-0 top-1/2 hidden -translate-y-1/2 lg:block lg:w-[480px] xl:w-[560px]"
  aria-hidden="true"
>
  <svg viewBox="0 0 560 436" fill="none" xmlns="http://www.w3.org/2000/svg">
    <!-- mooring lines -->
    {
      placed.map((n) => (
        <path id={n.id} d={n.edge} stroke="#3BA7B8" stroke-opacity="0.13" stroke-width="1" />
      ))
    }
    {
      placed.map((n) => (
        <path
          d={n.edge}
          stroke="#3BA7B8"
          stroke-opacity="0.3"
          stroke-width="1"
          stroke-dasharray="2 8"
          class="fleet-flow"
        />
      ))
    }

    <!-- traffic pulses: inbound requests + outbound heartbeats -->
    {
      placed.map((n) => (
        <circle r="2" fill={n.outbound ? '#3BA7B8' : '#E0A458'} opacity="0.85" class="fleet-packet">
          <animateMotion dur={`${n.inDur}s`} begin={n.begin} repeatCount="indefinite">
            <mpath href={`#${n.id}`} />
          </animateMotion>
        </circle>
      ))
    }
    {
      placed
        .filter((n) => n.outbound)
        .map((n) => (
          <circle r="1.4" fill="#4FD1A5" opacity="0.6" class="fleet-packet">
            <animateMotion dur={`${n.outDur}s`} begin={n.begin} repeatCount="indefinite">
              <mpath href={`#${n.id}-r`} />
            </animateMotion>
          </circle>
        ))
    }
    {
      placed
        .filter((n) => n.outbound)
        .map((n) => <path id={`${n.id}-r`} d={n.edgeR} stroke="none" />)
    }

    <!-- hub: the harbor itself -->
    <g class="fleet-ring">
      <circle cx={cx} cy={cy} r="38" stroke="#E0A458" stroke-opacity="0.22" stroke-dasharray="1 5" stroke-width="2" />
    </g>
    <g class="fleet-ring-rev">
      <circle cx={cx} cy={cy} r="27" stroke="#3BA7B8" stroke-opacity="0.3" stroke-dasharray="1 4" stroke-width="1.5" />
    </g>
    <g class="fleet-ring-slow">
      <circle cx={cx} cy={cy} r="17" stroke="#E0A458" stroke-opacity="0.4" stroke-dasharray="1 3" stroke-width="1.5" />
    </g>
    <circle cx={cx} cy={cy} r="4.5" fill="#E0A458" class="fleet-hub-dot" />
    <text
      x={cx}
      y={cy + 54}
      text-anchor="middle"
      fill="#93A7BD"
      font-size="9"
      font-family="'JetBrains Mono', ui-monospace, monospace"
      letter-spacing="0.18em"
    >
      digital harbor
    </text>

    <!-- fleet nodes -->
    {
      placed.map((n) => (
        <g transform={`translate(${n.x.toFixed(1)} ${n.y.toFixed(1)})`}>
          <rect
            x="-54"
            y="-14"
            width="108"
            height="28"
            rx="5"
            fill="#0F1D2C"
            fill-opacity="0.74"
            stroke={n.status}
            stroke-opacity="0.32"
          />
          <circle cx="-44" cy="0" r="2" fill={n.status} opacity="0.9" />
          <text
            text-anchor="middle"
            x="4"
            y="-2.5"
            fill="#A7B8CB"
            font-size="8.5"
            font-family="'JetBrains Mono', ui-monospace, monospace"
            letter-spacing="0.06em"
          >
            {n.s.slug}
          </text>
          <text
            text-anchor="middle"
            x="4"
            y="8.5"
            fill={n.status}
            font-size="6.5"
            font-family="'JetBrains Mono', ui-monospace, monospace"
            letter-spacing="0.2em"
          >
            {n.s.status.toUpperCase()}
          </text>
        </g>
      ))
    }
  </svg>
</div>

<style>
  .fleet-graph {
    mask-image: radial-gradient(
      ellipse 80% 82% at 56% 50%,
      black 58%,
      transparent 100%
    );
    -webkit-mask-image: radial-gradient(
      ellipse 80% 82% at 56% 50%,
      black 58%,
      transparent 100%
    );
    opacity: 0.9;
  }

  .fleet-ring,
  .fleet-ring-rev,
  .fleet-ring-slow {
    transform-box: fill-box;
    transform-origin: center;
  }
  .fleet-ring {
    animation: fleetSpin 90s linear infinite;
  }
  .fleet-ring-rev {
    animation: fleetSpin 130s linear infinite reverse;
  }
  .fleet-ring-slow {
    animation: fleetSpin 60s linear infinite;
  }

  @keyframes fleetSpin {
    to {
      transform: rotate(360deg);
    }
  }

  .fleet-flow {
    animation: fleetDash 1.4s linear infinite;
  }
  @keyframes fleetDash {
    to {
      stroke-dashoffset: -10;
    }
  }

  .fleet-hub-dot {
    animation: fleetHubPulse 2.4s ease-in-out infinite;
  }
  @keyframes fleetHubPulse {
    0%,
    100% {
      opacity: 1;
      r: 4.5;
    }
    50% {
      opacity: 0.55;
      r: 3.5;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fleet-ring,
    .fleet-ring-rev,
    .fleet-ring-slow,
    .fleet-flow,
    .fleet-hub-dot {
      animation: none !important;
    }
    .fleet-packet {
      display: none;
    }
  }
</style>
