---
import { Mail, Github } from 'lucide-astro';

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-white/5">
  <div class="mx-auto max-w-6xl px-4 py-12">
    <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="kicker mb-3">41.25&deg;N &middot; Fox Cities, WI</p>
        <p class="font-display text-xl tracking-tight text-ink">Digital Harbor</p>
        <p class="mt-1 text-sm text-ink-faint">
          Sites built, hosted, and kept running.
        </p>
      </div>

      <div class="flex flex-col gap-3 text-sm">
        <a
          href="mailto:nic@mydigitalharbor.com"
          class="flex items-center gap-2 text-ink-mute transition-colors hover:text-brass"
        >
          <Mail class="h-4 w-4" /> nic@mydigitalharbor.com
        </a>
        <a
          href="https://github.com/pypeaday/DigitalHarbor"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 text-ink-mute transition-colors hover:text-brass"
        >
          <Github class="h-4 w-4" /> pypeaday/DigitalHarbor
        </a>
      </div>
    </div>

    <hr class="hairline my-8" />

    <div class="flex flex-col items-start justify-between gap-2 font-mono text-[11px] tracking-wide text-ink-faint sm:flex-row">
      <span>&copy; {year} Digital Harbor</span>
      <span>Fast. Secure. Always on.</span>
    </div>
  </div>
</footer>
