---
import type { SiteStatus } from '../data/sites';

interface Props {
  status: SiteStatus;
  label?: boolean;
}

const { status, label = true } = Astro.props;

const styles: Record<SiteStatus, { dot: string; text: string; pulse: boolean; ring?: boolean }> = {
  live: { dot: 'bg-signal', text: 'text-signal', pulse: true },
  building: { dot: 'bg-brass', text: 'text-brass', pulse: true },
  paused: { dot: 'bg-ink-faint', text: 'text-ink-faint', pulse: false },
  planned: { dot: 'border border-dashed border-ink-faint', text: 'text-ink-faint', pulse: false },
};
const s = styles[status];
---

<span class="inline-flex items-center gap-1.5">
  <span
    class:list={[
      'inline-block h-2 w-2 rounded-full',
      s.dot,
      s.pulse && 'animate-pulse-soft',
    ]}
  ></span>
  {label && <span class:list={['font-mono text-[11px] uppercase tracking-wider', s.text]}>{status}</span>}
</span>
